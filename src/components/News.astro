---
import NewsItem from '@components/NewsItem.astro'
import { ListNews } from '../data/news.ts'

const visibleNews = [
  ListNews[0], ListNews[1]
]

const newList = ListNews.slice(2)
---

<div class="col-span-10 col-start-2 md:col-span-4 md:col-start-5 pt-10">
  <div class="border-1 border-solid rounded-lg border-primary p-2 bg-background">
    <h3 class="text-lg font-semibold text-primary mb-3">News:</h3>
    <ul class="grid grid-cols-[auto_max-content_1fr] gap-x-3 gap-y-2 text-sm">
      {visibleNews.map(news => (
        <NewsItem date={news.date} emoji={news.emoji}>{news.text}</NewsItem>
      ))}
    </ul>
    {newList.length > 0 && (
      <details class="group mt-2">
        <summary
          class="cursor-pointer text-primary font-bold text-sm mt-3 list-none inline-flex items-center gap-1 hover:underline">
          <span class="group-open:hidden">Show more {newList.length}</span>
          <span class="hidden group-open:inline">Show less</span>
          <svg
            class="w-4 h-4 transition-transform group-open:rotate-180"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <ul class="grid grid-cols-[auto_max-content_1fr] gap-x-3 gap-y-2 text-sm">
          {newList.map(news => (
            <NewsItem date={news.date} emoji={news.emoji}>{news.text}</NewsItem>
          ))}
        </ul>
      </details>
    )}
  </div>
</div>
